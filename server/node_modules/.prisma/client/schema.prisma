datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String
  tokenVersion     Int       @default(1)
  isEmailVerified  Boolean   @default(false)
  verificationCode String?
  resetOtp         String?
  resetOtpExpires  DateTime?
  bio              String?   @default("Aspiring Grand Alchemist")
  pfpPath          String?   @default("/assets/avatars/default_alchemist.png")
  bannerPath       String?   @default("/assets/banners/mystic_library.jpg")
  streak           Int       @default(0)
  lastStreakDate   DateTime?
  createdAt        DateTime  @default(now())

  // Relational mappings
  gameData      GameData?
  userData      UserData?
  tasks         Task[]
  itineraries   Itinerary[]
  userInventory UserInventory[]
  userBadges    UserBadge[]
  mailbox       MailboxItem[]
  focusSessions FocusSession[]
  userStickers  UserSticker[]

  @@index([id])
  @@index([username])
  @@index([email])
}

model UserData {
  id                        Int     @id @default(autoincrement())
  userId                    String  @unique
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTaskPoolIndexes      String  @default("[]") // JSON string array of template IDs
  todaysDailyTaskIndexes    String  @default("[]") // JSON string array of active daily task IDs
  todaysCompletedDailyTasks String  @default("[]") // JSON string array of completed daily task IDs
  badges                    String  @default("[]") // JSON string array of badge IDs
  streak                    Int     @default(0)
  profilePicturePath        String?
  bannerPath                String?

  @@index([userId])
}

model GameData {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp     Int    @default(0)
  level  Int    @default(1)
  gold   Int    @default(50)
  items  String @default("[]") // JSON representation of inventory for game data schema compatibility

  @@index([userId])
}

model Task {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  type            String // "DAILY" or "TODO"
  xpReward        Int       @default(50)
  materialRewards String    @default("[]") // JSON array of item IDs [1, 3]
  isCompleted     Boolean   @default(false)
  proofUrl        String?
  proofNote       String?
  status          String    @default("PENDING") // "PENDING", "PROCESSING", "APPROVED", "REJECTED"
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

model Itinerary {
  id               Int       @id @default(autoincrement())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  todoTaskHeading  String
  timeOfCompletion DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Item {
  id            Int             @id @default(autoincrement())
  name          String
  description   String?
  type          String // "HERB", "POTION", "MATERIAL", "CATALYST"
  rarity        String          @default("COMMON") // "COMMON", "UNCOMMON", "RARE", "LEGENDARY"
  imagePath     String
  value         Int             @default(10)
  userInventory UserInventory[]
  mailboxItems  MailboxItem[]
}

model UserInventory {
  id       Int    @id @default(autoincrement())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   Int
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Int    @default(1)

  @@unique([userId, itemId])
  @@index([userId])
}

model Badge {
  id          Int         @id @default(autoincrement())
  name        String
  description String
  imagePath   String
  rarity      String      @default("COMMON")
  userBadges  UserBadge[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  Int
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model MailboxItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    Int?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  badgeId   Int?
  badgeName String?
  xp        Int      @default(0)
  gold      Int      @default(0)
  message   String
  isClaimed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model FocusSession {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMinutes Int
  herbsYielded    String   @default("[]") // JSON array of item objects
  completedAt     DateTime @default(now())

  @@index([userId])
}

model NpcOrder {
  id                 Int    @id @default(autoincrement())
  npcName            String
  npcSprite          String
  requestedPotionId  Int
  requestedPotionQty Int    @default(1)
  dialog             String
  goldReward         Int
  rareHerbRewardId   Int?
  badgeRewardId      Int?
}

model BannerCosmetic {
  id          Int    @id @default(autoincrement())
  name        String
  imagePath   String
  priceGold   Int
  description String
}

model Sticker {
  id           Int           @id @default(autoincrement())
  name         String
  imagePath    String
  goldCost     Int           @default(30)
  category     String?       @default("alchemy")
  userStickers UserSticker[]
}

model UserSticker {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId   Int
  sticker     Sticker  @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  purchasedAt DateTime @default(now())

  @@unique([userId, stickerId])
  @@index([userId])
}
